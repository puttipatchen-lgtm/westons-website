{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "login": true,
  "preferredVersions": { "php": "8.2", "wp": "latest" },
  "features": { "networking": true },
  "steps": [
    { "step": "setSiteOptions", "options": { "blogname": "Westons Thai", "permalink_structure": "/%postname%/", "blog_public": "0", "timezone_string": "Asia/Bangkok" } },
    { "step": "installTheme", "themeData": { "resource": "url", "url": "https://raw.githubusercontent.com/puttipatchen-lgtm/westons-website/main/westons-block.zip" }, "options": { "activate": true } },
    { "step": "installPlugin", "pluginData": { "resource": "url", "url": "https://raw.githubusercontent.com/puttipatchen-lgtm/westons-website/main/westons-site.zip" }, "options": { "activate": true } },
    { "step": "runPHP", "code": "<?php require_once '/wordpress/wp-load.php'; require_once ABSPATH . 'wp-admin/includes/image.php'; require_once ABSPATH . 'wp-admin/includes/file.php'; require_once ABSPATH . 'wp-admin/includes/media.php'; wt_install_demo_content(); flush_rewrite_rules();" }
  ]
}
